{
  "name": "squash-league-app",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node test/run-browser.mjs",
