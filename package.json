    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "1.63",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
