# Copy this file to .env and fill in the values before starting the server.
# .env is gitignored — never commit it.

# Required: Admin login password (choose something strong)
SITE_PASSWORD=

# Required: Long random string used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Required for email features (invite links, password resets, messaging players).
# Get your key from https://resend.com
RESEND_API_KEY=

# Base URL used for links inside emails (invite, password reset, reminders).
# Required once background jobs send mail — they have no request to derive it from.
# APP_URL=https://www.playwsrc.ca

# STAGING ONLY. When set, every outgoing email is redirected to this one address
# instead of the real recipient, with the intended recipient shown in the subject.
# Lets staging send for real without any chance of reaching a member.
# Leave unset in production.
# EMAIL_REDIRECT_TO=you@example.com

# STAGING ONLY, and only alongside EMAIL_REDIRECT_TO. Comma-separated addresses
# that are exempt from the redirect, so named testers receive their invites for
# real while every other address still goes to the sink. A message is sent for
# real only when all of its recipients are listed.
# EMAIL_ALLOWLIST=tester1@example.com,tester2@example.com

# Optional overrides
# PORT=8080
# DB_PATH=./squash.db
# AVATAR_DIR=./avatars        # defaults to an "avatars" folder beside the database
# NODE_ENV=production
# RESEND_FROM=Play WSRC <no-reply@playwsrc.ca>

# ----- Operations (all optional) -----
# Log level: fatal, error, warn, info (default), debug. Logs are JSON lines in
# production (Railway parses level/message; search other fields with @field:value)
# and readable text on a terminal.
# LOG_LEVEL=info
# LOG_FORMAT=json           # force JSON lines even on a terminal

# Error tracking. Set a Sentry DSN and every 500, crash and failed background
# job is reported there with the request id and who was signed in.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# Nightly database backups: a verified copy of squash.db beside it, every night
# at BACKUP_TIME on the club's clock, keeping the newest BACKUP_KEEP.
# BACKUP_DIR=/data/backups  # default: a "backups" folder beside the database
# BACKUP_KEEP=14
# BACKUP_TIME=03:30

# Off-volume copy of each backup, gzipped, to any S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2). Leave unset to keep backups on the
# volume only; the admin can still download one from /api/backups/latest.
# BACKUP_S3_BUCKET=wsrc-backups
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2/B2 only
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=backups/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
